{
  "name": "affect",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "portless run --name affect-tanstack bun run --filter @affect/web dev",
    "dev:localhost": "bun run --filter @affect/web dev:localhost",
    "build": "bun run --filter @affect/web build",
    "start": "bun run --filter @affect/web start",
    "preview": "bun run --filter @affect/web preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex && bun run --filter @affect/web typecheck",
    "lint": "ultracite check --disable-nested-config --no-ignore",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "knip": "knip",
    "check": "bun run --sequential typecheck lint test format:check knip",
    "prepare": "effect-tsgo patch --no-typescript --oxlint"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.13.0",
    "@convex-dev/migrations": "0.3.7",
    "@convex-dev/rate-limiter": "0.4.3",
    "@convex-dev/workflow": "0.4.10",
    "@opentelemetry/api": "1.9.1",
    "@posthog/convex": "2.1.8",
    "better-auth": "1.7.18",
    "convex": "1.49.0",
    "convex-helpers": "0.1.133",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "5.0.1",
    "@effect/tsgo": "0.64.1",
    "@effect/vitest": "4.1.2",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@tanstack/intent": "0.5.5",
    "@types/bun": "1.4.4",
    "@types/node": "^24.0.0",
    "affect-cli": "0.0.5",
    "auth": "1.7.18",
    "convex-test": "0.0.67",
    "happy-dom": "21.0.4",
    "knip": "6.44.1",
    "oxfmt": "0.76.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "portless": "0.15.4",
    "typescript": "7.0.2",
    "ultracite": "8.1.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.4"
  },
  "engines": {
    "node": ">=24.22.2"
  },
  "packageManager": "bun@1.4.4",
  "intent": {
    "skills": [
      "@tanstack/react-start#react-start",
      "@tanstack/react-start#lifecycle/migrate-from-nextjs",
      "@tanstack/react-router#react-router",
      "@tanstack/react-router#compositions/router-query",
      "@tanstack/router-core#router-core",
      "@tanstack/router-core#router-core/auth-and-guards",
      "@tanstack/router-core#router-core/data-loading",
      "@tanstack/router-core#router-core/search-params",
      "@tanstack/router-core#router-core/ssr",
      "@tanstack/router-core#router-core/type-safety",
      "@tanstack/start-client-core#start-core",
      "@tanstack/start-client-core#start-core/middleware",
      "@tanstack/start-client-core#start-core/server-functions",
      "@tanstack/start-client-core#start-core/server-routes",
      "@tanstack/start-client-core#start-core/deployment"
    ]
  }
}
